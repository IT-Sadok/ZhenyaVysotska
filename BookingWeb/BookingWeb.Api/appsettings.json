{
  "Jwt": {
    "Issuer": "BookingWeb",
    "Audience": "BookingWeb",
    "ExpiryMinutes": 60
  },
  "RefreshTokens": {
    "ExpiryDays": 7
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "BookingWeb/1.0 (learning project)",
    "AcceptLanguage": "uk,en",
    "CountryCodes": "ua",
    "TimeoutSeconds": 5,
    "QueueLimit": 3
  },
  "RateLimiting": {
    "GeocodingSearch": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
