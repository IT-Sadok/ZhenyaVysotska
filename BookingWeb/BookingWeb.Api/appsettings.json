{
  "Jwt": {
    "Issuer": "BookingWeb",
    "Audience": "BookingWeb",
    "ExpiryMinutes": 60
  },
  "RefreshTokens": {
    "ExpiryDays": 7
  },
  "Nominatim": {
    "Enabled": true,
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "BookingWeb/1.0 (learning project)",
    "AcceptLanguage": "uk,en",
    "TimeoutSeconds": 5,
    "QueueLimit": 3
  }
}
